@import 'leaflet/dist/leaflet.css';
@import 'vue3-toastify/dist/index.css';

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  body {
    @apply bg-barber-light text-barber-dark antialiased selection:bg-barber-red selection:text-white;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
}

/* Ajuste para evitar que los controles del mapa Leaflet tapen modales o menús móviles */
.leaflet-container {
  z-index: 10 !important;
}